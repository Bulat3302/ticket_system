# ============================================================
#  Единый конфиг для локального запуска и production.
#  Скопируйте в .env и заполните секреты:  cp .env.example .env
#  Запуск — только через:  sudo bash infra/up.sh
# ============================================================

# Режим: development | production
#   development → http://localhost:18080, демо-учётки, OpenAPI включён
#   production  → https://<IP или домен>, демо-учётки удаляются
NODE_ENV=production

# Публичный адрес системы. Можно оставить пустым:
#   - production  → up.sh сам определит IP и поставит https://IP
#   - development → up.sh поставит http://localhost:18080
# Для домена задайте явно: PUBLIC_ORIGIN=https://queue.example.ru
PUBLIC_ORIGIN=

# Порты nginx на хосте.
#   production: 80/443.  development: 18080/18443 (и PUBLIC_ORIGIN=http://localhost:18080)
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# --- Обязательные секреты (сгенерируйте: openssl rand -hex 32) ---
# Пароли без пробелов и символов $ и #.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
OIDC_CLIENT_SECRET=

# --- Keycloak: вход в админ-консоль /admin/ (realm master) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Первый администратор приложения /staff/ (realm ticket-system) ---
# В production демо-учётки удаляются, поэтому обязательно задайте первого админа.
STAFF_ADMIN_USERNAME=
STAFF_ADMIN_PASSWORD=

# --- Хранение данных (дней) ---
RETENTION_TICKET_DAYS=90
RETENTION_AUDIT_DAYS=365

# Остальное (COOKIE_SECURE, ENABLE_OPENAPI, ALLOW_LOCALHOST_CORS, DB_SYNCHRONIZE)
# выводится автоматически из NODE_ENV. При желании их можно переопределить здесь.
# DB_SYNCHRONIZE=false  (по умолчанию применяются миграции)
